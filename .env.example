# Claude API のキー（https://platform.claude.com で発行）
ANTHROPIC_API_KEY=
# 画面で最初に選ばれているモデル（空欄なら claude-sonnet-5-5）
ANTHROPIC_MODEL=claude-sonnet-5-5
# 公開時に必要な安全確認用の共有保存先（手元の npm run dev では空欄で利用可）
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# ほかのアプリやプレビューと保存先を共用する場合は、異なる識別名を指定
SECURITY_STORE_PREFIX=keiri
# 公開時だけ適用する利用制限（空欄でも以下の既定値が有効。料金の金額上限ではありません）
# Claude Consoleの専用ワークスペースで、別途月額上限と通知を確認してください。
PUBLIC_RUNS_PER_HOUR=5
PUBLIC_RUNS_PER_DAY=10
PUBLIC_RUNS_PER_BROWSER_HOUR=5
PUBLIC_RUNS_PER_ADDRESS_HOUR=3
PUBLIC_MAX_OUTPUT_TOKENS=8000
PUBLIC_MAX_ROUNDS=6
PUBLIC_DEFAULT_MODEL=claude-haiku-5-5
PUBLIC_DEFAULT_EFFORT=low
